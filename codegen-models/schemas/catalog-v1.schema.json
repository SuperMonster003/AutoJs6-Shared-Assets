{
  "$defs": {
    "displayName": {
      "additionalProperties": false,
      "maxProperties": 64,
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
          "type": "string"
        }
      },
      "required": [
        "en"
      ],
      "type": "object"
    },
    "metric": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "regret": {
                "type": "number"
              },
              "ruleTop1Survival": {
                "type": "number"
              },
              "top1Survival": {
                "type": "number"
              }
            }
          },
          "if": {
            "properties": {
              "groups": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "regret": {
                "type": "null"
              },
              "ruleTop1Survival": {
                "type": "null"
              },
              "top1Survival": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "groups": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "regret": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "ruleTop1Survival": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "top1Survival": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "groups",
        "top1Survival",
        "ruleTop1Survival",
        "regret"
      ],
      "type": "object"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "realTest": {
          "$ref": "#/$defs/metric"
        },
        "test": {
          "$ref": "#/$defs/metric"
        }
      },
      "required": [
        "test",
        "realTest"
      ],
      "type": "object"
    },
    "modelId": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
      "type": "string"
    },
    "namesHash": {
      "pattern": "^[0-9a-f]{16}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "summary": {
      "additionalProperties": false,
      "maxProperties": 64,
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
          "type": "string"
        }
      },
      "required": [
        "en"
      ],
      "type": "object"
    },
    "timestamp": {
      "format": "date-time",
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:(?:0[0-9]|1[0-7]):[0-5][0-9]|18:00))(?![\\s\\S])",
      "type": "string"
    }
  },
  "$id": "https://github.com/SuperMonster003/AutoJs6-Shared-Assets/blob/main/codegen-models/schemas/catalog-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalogVersion": {
      "maximum": 2147483647,
      "minimum": 1,
      "type": "integer"
    },
    "generatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "models": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "$ref": "#/$defs/displayName"
          },
          "modelId": {
            "$ref": "#/$defs/modelId"
          },
          "recommendedVersionCode": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "summary": {
            "$ref": "#/$defs/summary"
          },
          "versions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "artifact": {
                  "additionalProperties": false,
                  "properties": {
                    "fileName": {
                      "pattern": "^autojs6-codegen-[a-z0-9][a-z0-9._-]{1,63}-v[1-9][0-9]*-[0-9a-f]{8}\\.ajcgm$",
                      "type": "string"
                    },
                    "sha256": {
                      "$ref": "#/$defs/sha256"
                    },
                    "size": {
                      "maximum": 104857599,
                      "minimum": 1,
                      "type": "integer"
                    },
                    "url": {
                      "format": "uri",
                      "maxLength": 2048,
                      "minLength": 1,
                      "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/download/codegen-models-v[1-9][0-9]*/autojs6-codegen-[a-z0-9._-]+-v[1-9][0-9]*-[0-9a-f]{8}\\.ajcgm$",
                      "type": "string"
                    },
                    "urls": {
                      "items": {
                        "format": "uri",
                        "maxLength": 2048,
                        "minLength": 1,
                        "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/download/codegen-models-v[1-9][0-9]*/autojs6-codegen-[a-z0-9._-]+-v[1-9][0-9]*-[0-9a-f]{8}\\.ajcgm$",
                        "type": "string"
                      },
                      "maxItems": 16,
                      "minItems": 1,
                      "type": "array",
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "fileName",
                    "size",
                    "sha256",
                    "url",
                    "urls"
                  ],
                  "type": "object"
                },
                "datasetId": {
                  "maxLength": 1024,
                  "minLength": 1,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
                  "type": "string"
                },
                "deprecated": {
                  "type": "boolean"
                },
                "featureNamesHash": {
                  "$ref": "#/$defs/namesHash"
                },
                "featureSchemaVersion": {
                  "maximum": 2147483647,
                  "minimum": 1,
                  "type": "integer"
                },
                "license": {
                  "additionalProperties": false,
                  "properties": {
                    "spdx": {
                      "maxLength": 256,
                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "spdx"
                  ],
                  "type": "object"
                },
                "metrics": {
                  "$ref": "#/$defs/metrics"
                },
                "minHostVersionCode": {
                  "maximum": 2147483647,
                  "minimum": 1,
                  "type": "integer"
                },
                "releasedAt": {
                  "$ref": "#/$defs/timestamp"
                },
                "revoked": {
                  "type": "boolean"
                },
                "versionCode": {
                  "maximum": 2147483647,
                  "minimum": 1,
                  "type": "integer"
                },
                "versionName": {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
                  "type": "string"
                }
              },
              "required": [
                "versionCode",
                "versionName",
                "featureSchemaVersion",
                "featureNamesHash",
                "minHostVersionCode",
                "artifact",
                "releasedAt",
                "datasetId",
                "metrics",
                "license"
              ],
              "type": "object"
            },
            "maxItems": 4096,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "modelId",
          "displayName",
          "summary",
          "versions",
          "recommendedVersionCode"
        ],
        "type": "object"
      },
      "maxItems": 4096,
      "type": "array"
    },
    "releaseTag": {
      "pattern": "^codegen-models-v[1-9][0-9]*$",
      "type": "string"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "schemaVersion",
    "catalogVersion",
    "releaseTag",
    "generatedAt",
    "repository",
    "models"
  ],
  "title": "AutoJs6 code-generation model catalog v1",
  "type": "object"
}
