  "names": [
    {"dz":"དགུན་ཉི་ལྡོག་གི་ངལ་གསོལ།","en-US":"Winter Solstice"},
    {"dz":"སྔར་སྲོལ་འབུལ་བའི་ལོ་གསར་གྱི་ངལ་གསོལ།","en-US":"Traditional Day of Offering"},
    {"dz":"མི་དབང་མངའ་བདག་རིན་པོ་ཆེའི་འཁྲུངས་སྐར་དུས་ཆེན་ངལ་གསོལ།","en-US":"Birth Anniversary of His Majesty the King"},
    {"dz":"གནམ་ལོ་གསར་ཚེས་ཀྱིས་དུས་སྟོན་ངལ་གསོལ།","en-US":"Losar"},
    {"dz":"མཐུ་ཆེན་ཆོས་ཀྱི་རྒྱལ་པོའི་དུས་ཆེན་ངལ་གསོལ།","en-US":"Birth Anniversary of the 3rd Druk Gyalpo"},
    {"dz":"མི་དབང་འབྲུག་རྒྱལ་གསུམ་པའི་འཁྲུངས་སྐར་དུས་ཆེན་ངལ་གསོལ།","en-US":"Death Anniversary of Zhabdrung"},
    {"dz":"སངས་རྒྱས་བཅོམ་ལྡན་འདས་ཀྱི་དུས་ཆེན་ལྔ་འཛོམས་ངལ་གསོལ།","en-US":"Lord Buddha's Parinirvana"},
    {"dz":"ཨོ་རྒྱན་གུ་རུ་རིན་པོ་ཆེའི་འཁྲུངས་སྐར་དུས་ཆེན་ངལ་གསོ།","en-US":"Birth Anniversary of Guru Rinpoche"},
    {"dz":"སྟོན་པ་མཆོག་ཝ་ར་ན་སིར་བདེན་བཞིའི་ཆོས་འཁོར་བསྐོར་བའི་དུས་ཆེན་ངལ་གསོ།","en-US":"First Sermon of Lord Buddha"},
