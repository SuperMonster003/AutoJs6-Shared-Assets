{
  "$comment": "Cross-field rules are enforced by tools/holiday-calendar-distribution/calendar_format.py: calendar holds exactly the years of years; name indexes are in range and every name is used; a makeup workday falls on that year's weekend and is not a holiday; a year or subdivision weekend differs from the one it overrides; a subdivision holiday differs from the national entry and a removed date is a national holiday of that year; hasMakeupWorkdays is true exactly when some year has workdays; arrays are sorted and unique.",
  "$defs": {
    "holidayMap": {
      "additionalProperties": {
        "items": {
          "minimum": 0,
          "type": "integer"
        },
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      },
      "description": "MM-DD -> indexes into names",
      "propertyNames": {
        "$ref": "#/$defs/monthDay"
      },
      "type": "object"
    },
    "language": {
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "type": "string"
    },
    "monthDay": {
      "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "weekend": {
      "description": "ISO weekdays, 1 = Monday ... 7 = Sunday, ascending",
      "items": {
        "maximum": 7,
        "minimum": 1,
        "type": "integer"
      },
      "maxItems": 6,
      "type": "array",
      "uniqueItems": true
    },
    "year": {
      "maximum": 2200,
      "minimum": 1900,
      "type": "integer"
    },
    "yearRange": {
      "description": "[firstYear, lastYear], both inclusive",
      "items": false,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/year"
        },
        {
          "$ref": "#/$defs/year"
        }
      ],
      "type": "array"
    }
  },
  "$id": "https://github.com/SuperMonster003/AutoJs6-Shared-Assets/blob/main/holiday-calendars/schemas/calendar-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calendar": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "holidays": {
            "$ref": "#/$defs/holidayMap"
          },
          "weekend": {
            "$ref": "#/$defs/weekend"
          },
          "workdays": {
            "items": {
              "$ref": "#/$defs/monthDay"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "holidays",
          "workdays"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^[0-9]{4}$"
      },
      "type": "object"
    },
    "defaultLanguage": {
      "$ref": "#/$defs/language"
    },
    "estimatedFrom": {
      "description": "first year computed by rule only; null when every year is confirmed",
      "type": [
        "integer",
        "null"
      ]
    },
    "hasMakeupWorkdays": {
      "type": "boolean"
    },
    "languages": {
      "items": {
        "$ref": "#/$defs/language"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "name": {
      "$ref": "#/$defs/text"
    },
    "names": {
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/text"
        },
        "minProperties": 1,
        "propertyNames": {
          "$ref": "#/$defs/language"
        },
        "type": "object"
      },
      "type": "array"
    },
    "region": {
      "pattern": "^[A-Z]{2}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "package": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "name",
        "package",
        "version"
      ],
      "type": "object"
    },
    "subdivisions": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "calendar": {
            "additionalProperties": {
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "holidays": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/holidayMap"
                    },
                    {
                      "minProperties": 1
                    }
                  ]
                },
                "removed": {
                  "items": {
                    "$ref": "#/$defs/monthDay"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "weekend": {
                  "$ref": "#/$defs/weekend"
                }
              },
              "type": "object"
            },
            "propertyNames": {
              "pattern": "^[0-9]{4}$"
            },
            "type": "object"
          },
          "name": {
            "$ref": "#/$defs/text"
          }
        },
        "required": [
          "name",
          "calendar"
        ],
        "type": "object"
      },
      "propertyNames": {
        "$ref": "#/$defs/text",
        "not": {
          "pattern": "/"
        }
      },
      "type": "object"
    },
    "weekend": {
      "$ref": "#/$defs/weekend"
    },
    "years": {
      "$ref": "#/$defs/yearRange"
    }
  },
  "required": [
    "schemaVersion",
    "region",
    "name",
    "source",
    "years",
    "estimatedFrom",
    "weekend",
    "hasMakeupWorkdays",
    "defaultLanguage",
    "languages",
    "names",
    "calendar",
    "subdivisions"
  ],
  "title": "AutoJs6 holiday calendar file v1",
  "type": "object"
}
